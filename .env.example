# PeruvianFootballBot v2.0 — variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# El .env NUNCA se commitea (ya está en .gitignore).

# App de Meta: PeruvianFootballBot v2.0
FB_APP_ID=
FB_APP_SECRET=

# Página real del bot (Peruvian Football BOT 1)
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Página de pruebas (Pruebas de bots) — destino de los tests de publicación
FB_TEST_PAGE_ID=
FB_TEST_PAGE_TOKEN=

# Version de la Graph API contra la que se llama
FB_API_VERSION=v26.0

IG_USER_ID=
